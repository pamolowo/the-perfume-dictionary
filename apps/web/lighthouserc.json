{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/perfumes",
        "http://localhost:3000/perfumes/casa-ficta-caffe-notturno",
        "http://localhost:3000/notes",
        "http://localhost:3000/notes/vanilla",
        "http://localhost:3000/accords/woody",
        "http://localhost:3000/brands/casa-ficta",
        "http://localhost:3000/search?q=vanilla"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "document-title": "error",
        "html-has-lang": "error",
        "canonical": "error",
        "link-text": "error",
        "crawlable-anchors": "error",
        "http-status-code": "error",
        "image-alt": "error",
        "heading-order": "error",
        "errors-in-console": "error",
        "color-contrast": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-results"
    }
  }
}
