# Copy to .env for local development. Never commit .env. Staging/production values live in the cloud secret manager.

# API (apps/api)
DATABASE_URL=postgresql+psycopg://perfume:perfume@localhost:5432/perfume
ENVIRONMENT=local
LOG_LEVEL=INFO
# pool (servers, containers) | none (serverless hosts such as Vercel, with Neon's -pooler connection string)
DB_POOLING=pool
CORS_ORIGINS=["http://localhost:3000"]

# Web (apps/web)
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tests
TEST_DATABASE_URL=postgresql+psycopg://perfume:perfume@localhost:5432/perfume_test
